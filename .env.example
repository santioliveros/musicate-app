# Supabase — proyecto dev (Project Settings → API)
# Copiá este archivo a .env.local y completá los valores.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Analítica (opcional en desarrollo)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (solo en builds)
SENTRY_AUTH_TOKEN=

# Nunca pongas la service_role en la app. Solo vive en Edge Functions.
